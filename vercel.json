{
  "framework": null,
  "installCommand": "npm install --include=dev --ignore-scripts",
  "buildCommand": "npm run build || echo build-warning; test -f dist/index.js && npm prune --omit=dev",
  "outputDirectory": "public",
  "functions": {
    "api/index.js": {
      "maxDuration": 30,
      "includeFiles": "{dist/**,node_modules/**,package.json}"
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api/index" }]
}
